# Използваме лека версия на Python
FROM python:3.11-slim

# Изключваме буферирането за по-добри логове
ENV PYTHONUNBUFFERED=1

# Работна директория
WORKDIR /app

# Копираме всички файлове от вашия компютър в контейнера
COPY . /app/

# Създаваме папката за базата данни, ако липсва
RUN mkdir -p /app/data

# Приложението ви слуша на порт 8000 по подразбиране
EXPOSE 8000

# Стартираме сървъра
CMD ["python", "main.py"]
